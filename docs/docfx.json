{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "pdf-cover.html"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Raph's Craft documentation",
      "_appTitle": "Raph's Craft documentation",
      "_appFaviconPath": "images/logo.svg",
      "_appLogoPath": "images/logo.svg",
      "_enableSearch": true,
      "_disableToc": false,
      "_disableBreadcrumb": false,
      "_appFooter": "Raph's Craft documentation (powered by the Docfx generator.)",
      "pdf": true,
      "pdfHeaderTemplate": "<div style=\"width: 100%; font-size: 12px; margin-bottom: 6px;\"><div style=\"float: left; padding: 0 2em\"><span>Raph's Craft Documentation</div><div style=\"float: right; padding: 0 2em\">Page <span class=\"pageNumber\"></span> of <span class=\"totalPages\"></span>\n</div>\n</div>",
      "pdfFooterTemplate": "<p></p>",
      "pdfTocPage": true,
      "pdfCoverPage": "pdf-cover.html"
    }
  }
}